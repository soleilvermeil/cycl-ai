# Amorçage au premier démarrage uniquement : ensuite, tout se règle dans /settings.
# Aucune de ces variables n'est obligatoire.

DATABASE_URL=sqlite://cyclai.db

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Scope requis : read,activity:read_all
STRAVA_REFRESH_TOKEN=

# Optionnelles : sans clé pour le fournisseur choisi, utiliser les « rapports IA »
# téléchargeables. Un seul fournisseur est actif à la fois (/settings).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# FTP manuel (jamais l'auto-FTP Strava / Garmin) et fréquences cardiaques.
FTP_WATTS=200
HR_MAX=190
HR_REST=50

# Profil libre (physiologie, objectifs, terrain, équipement, biais connus),
# réinjecté dans chaque prompt LLM.
ATHLETE_PROFILE=

# Adresse d'écoute (défaut : 0.0.0.0:3000 pour `serve`, 0.0.0.0:3001 pour `serve-api`).
# BIND_ADDR=

# Clé personnelle Garmin Connect (Paramètres → Personal API). Une seule
# source est active à la fois : /settings, « Source de synchronisation ».
GARMIN_API_KEY=