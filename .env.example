# Amorçage au premier démarrage uniquement : ensuite, tout se règle dans /settings.
# Aucune de ces variables n'est obligatoire.

DATABASE_URL=sqlite://cyclai.db

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Scope requis : read,activity:read_all
STRAVA_REFRESH_TOKEN=

# Optionnelle : sans clé, utiliser les « rapports IA » téléchargeables.
ANTHROPIC_API_KEY=

# FTP manuel (jamais l'auto-FTP Strava / Garmin) et fréquences cardiaques.
FTP_WATTS=200
HR_MAX=190
HR_REST=50

# Profil libre (physiologie, objectifs, terrain, équipement, biais connus),
# réinjecté dans chaque prompt LLM.
ATHLETE_PROFILE=
